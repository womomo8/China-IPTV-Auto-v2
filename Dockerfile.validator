# syntax=docker/dockerfile:1.7

FROM debian:bookworm-slim

LABEL org.opencontainers.image.title="China-IPTV-Auto V3 Validator"
LABEL org.opencontainers.image.description="Isolated FFmpeg and FFprobe validation environment"

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/tmp
ENV TMPDIR=/tmp
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        nftables \
        util-linux \
        passwd \
    && groupadd --gid 10001 validator \
    && useradd \
        --uid 10001 \
        --gid 10001 \
        --no-create-home \
        --home-dir /nonexistent \
        --shell /usr/sbin/nologin \
        validator \
    && rm -rf /var/lib/apt/lists/*

RUN <<'DOCKERFILE_RUN'
cat > /usr/local/sbin/validator-entrypoint <<'ENTRYPOINT'
#!/bin/sh
set -eu

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

read_status() {
    awk -v key="$1" '$1 == key ":" {print $2}' /proc/self/status
}

check_status() {
    field="$1"
    expected="$2"
    actual="$(read_status "$field")"

    [ -n "$actual" ] || fail "Cannot read $field from /proc/self/status."

    [ "$actual" = "$expected" ] || fail \
        "$field mismatch: expected $expected, got $actual."
}

[ "$(id -u)" = "0" ] || fail \
    "Validator initialization must start as root."

command -v nft >/dev/null 2>&1 || fail \
    "nftables is not installed."

command -v setpriv >/dev/null 2>&1 || fail \
    "setpriv is not installed."

command -v ffmpeg >/dev/null 2>&1 || fail \
    "FFmpeg is not installed."

command -v ffprobe >/dev/null 2>&1 || fail \
    "FFprobe is not installed."

# Docker must remove all default capabilities and add only:
# NET_ADMIN, SETUID and SETGID.
# Their combined capability mask is 0x10c0.

EXPECTED_START_CAPS="00000000000010c0"
EXPECTED_EMPTY_CAPS="0000000000000000"

check_status CapEff "$EXPECTED_START_CAPS"
check_status CapPrm "$EXPECTED_START_CAPS"
check_status CapBnd "$EXPECTED_START_CAPS"
check_status CapInh "$EXPECTED_EMPTY_CAPS"
check_status CapAmb "$EXPECTED_EMPTY_CAPS"

if [ "$#" -eq 0 ]; then
    set -- sleep infinity
fi

echo "Validator startup capability check passed."

echo "Loading validator network firewall..."

nft -f - <<'NFT'
flush ruleset

table inet validator_filter {
    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept
        ct state established,related accept
    }

    chain output {
        type filter hook output priority filter; policy drop;

        oifname "lo" accept
        ct state established,related accept

        ip daddr 127.0.0.11 udp dport 53 accept
        ip daddr 127.0.0.11 tcp dport 53 accept

        ip daddr 172.30.10.2 tcp dport 8080 accept
    }
}
NFT

nft list table inet validator_filter >/dev/null \
    || fail "Firewall table verification failed."

echo "Firewall loaded and verified."

echo "Switching to validator UID/GID and clearing effective, permitted, inheritable and ambient capabilities..."

# Do not use --bounding-set=-all here.
# Clearing the bounding set requires CAP_SETPCAP, which is not granted.
# The three startup capabilities remain in CapBnd, but must not remain
# in CapEff or CapPrm after switching to the non-root user.
exec setpriv \
    --reuid=10001 \
    --regid=10001 \
    --clear-groups \
    --inh-caps=-all \
    --ambient-caps=-all \
    --no-new-privs \
    /usr/local/sbin/validator-user-entrypoint "$@"

fail "Privilege dropping unexpectedly returned."
ENTRYPOINT

cat > /usr/local/sbin/validator-user-entrypoint <<'USER_ENTRYPOINT'
#!/bin/sh
set -eu

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

read_status() {
    awk -v key="$1" '$1 == key ":" {print $2}' /proc/self/status
}

check_status() {
    field="$1"
    expected="$2"
    actual="$(read_status "$field")"

    [ -n "$actual" ] || fail "Cannot read $field from /proc/self/status."

    [ "$actual" = "$expected" ] || fail \
        "$field mismatch: expected $expected, got $actual."
}

EXPECTED_EMPTY_CAPS="0000000000000000"
EXPECTED_BOUNDING_CAPS="00000000000010c0"

[ "$(id -u)" = "10001" ] || fail \
    "Process is not running as UID 10001."

[ "$(id -g)" = "10001" ] || fail \
    "Process is not running as GID 10001."

check_status CapEff "$EXPECTED_EMPTY_CAPS"
check_status CapPrm "$EXPECTED_EMPTY_CAPS"
check_status CapInh "$EXPECTED_EMPTY_CAPS"
check_status CapAmb "$EXPECTED_EMPTY_CAPS"

# Only the three explicitly granted startup capabilities may remain
# in the bounding set. They are not effective or permitted.
check_status CapBnd "$EXPECTED_BOUNDING_CAPS"

check_status NoNewPrivs "1"

echo "Validator privilege verification passed."
echo "UID: $(id -u)"
echo "GID: $(id -g)"
echo "CapEff: $(read_status CapEff)"
echo "CapPrm: $(read_status CapPrm)"
echo "CapInh: $(read_status CapInh)"
echo "CapAmb: $(read_status CapAmb)"
echo "CapBnd: $(read_status CapBnd)"
echo "NoNewPrivs: $(read_status NoNewPrivs)"

exec "$@"
USER_ENTRYPOINT

chmod 0755 \
    /usr/local/sbin/validator-entrypoint \
    /usr/local/sbin/validator-user-entrypoint
DOCKERFILE_RUN

WORKDIR /tmp

ENTRYPOINT ["/usr/local/sbin/validator-entrypoint"]

CMD ["sleep", "infinity"]

STOPSIGNAL SIGTERM
