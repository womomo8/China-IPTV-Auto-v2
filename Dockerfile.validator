# syntax=docker/dockerfile:1.7

FROM debian:bookworm-slim

LABEL org.opencontainers.image.title="China-IPTV-Auto V3 Validator"
LABEL org.opencontainers.image.description="Network-isolated FFmpeg and FFprobe validation environment"

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/tmp
ENV TMPDIR=/tmp
ENV PATH=/usr/local/bin:/usr/bin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
    && groupadd --gid 10001 validator \
    && useradd \
        --uid 10001 \
        --gid 10001 \
        --no-create-home \
        --home-dir /nonexistent \
        --shell /usr/sbin/nologin \
        validator \
    && rm -rf /var/lib/apt/lists/*

RUN <<'DOCKERFILE_RUN'
cat > /usr/local/bin/validator-entrypoint <<'ENTRYPOINT'
#!/bin/sh
set -eu

fail() {
    echo "ERROR: $*" >&2
    exit 1
}

read_status() {
    awk -v key="$1" '$1 == key ":" {print $2}' /proc/self/status
}

check_status() {
    field="$1"
    expected="$2"
    actual="$(read_status "$field")"

    [ -n "$actual" ] || fail "Cannot read $field from /proc/self/status."

    [ "$actual" = "$expected" ] || fail \
        "$field mismatch: expected $expected, got $actual."
}

# The container must start directly as the unprivileged validator user.
[ "$(id -u)" = "10001" ] || fail \
    "Validator must run as UID 10001."

[ "$(id -g)" = "10001" ] || fail \
    "Validator must run as GID 10001."

# No Linux capabilities may be available to the process.
EXPECTED_EMPTY_CAPS="0000000000000000"

check_status CapEff "$EXPECTED_EMPTY_CAPS"
check_status CapPrm "$EXPECTED_EMPTY_CAPS"
check_status CapInh "$EXPECTED_EMPTY_CAPS"
check_status CapAmb "$EXPECTED_EMPTY_CAPS"
check_status CapBnd "$EXPECTED_EMPTY_CAPS"

# The host must enable no-new-privileges.
check_status NoNewPrivs "1"

command -v ffmpeg >/dev/null 2>&1 || fail \
    "FFmpeg is not installed."

command -v ffprobe >/dev/null 2>&1 || fail \
    "FFprobe is not installed."

echo "Validator identity and privilege verification passed."
echo "UID: $(id -u)"
echo "GID: $(id -g)"
echo "CapEff: $(read_status CapEff)"
echo "CapPrm: $(read_status CapPrm)"
echo "CapInh: $(read_status CapInh)"
echo "CapAmb: $(read_status CapAmb)"
echo "CapBnd: $(read_status CapBnd)"
echo "NoNewPrivs: $(read_status NoNewPrivs)"

exec "$@"
ENTRYPOINT

chmod 0755 /usr/local/bin/validator-entrypoint
DOCKERFILE_RUN

WORKDIR /tmp

USER 10001:10001

ENTRYPOINT ["/usr/local/bin/validator-entrypoint"]

CMD ["sleep", "infinity"]

STOPSIGNAL SIGTERM
